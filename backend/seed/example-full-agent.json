{
  "id": "example-full-agent",
  "name": "Example: Full agent (model + memory + tools)",
  "description": "An agent with all three capability ports: a Chat Model node picks the LLM, a Memory node makes it remember previous runs, and calculator + MCP tools are attached for the agent to call mid-reasoning. Needs an API key; the MCP tool needs the demo-tools server registered.",
  "nodes": [
    {
      "id": "start",
      "type": "input",
      "label": "Input",
      "position": { "x": 40, "y": 140 },
      "config": {}
    },
    {
      "id": "assistant",
      "type": "agent",
      "label": "Assistant",
      "position": { "x": 330, "y": 110 },
      "config": {
        "role": "Personal Assistant",
        "goal": "Answer the user's request, using your tools for any arithmetic and remembering facts the user tells you.",
        "task": "{{ input.task }}"
      }
    },
    {
      "id": "end",
      "type": "output",
      "label": "Output",
      "position": { "x": 660, "y": 140 },
      "config": {}
    },
    {
      "id": "chat_model",
      "type": "model",
      "label": "Claude Haiku",
      "position": { "x": 130, "y": 330 },
      "config": { "llm_model": "claude-haiku-4-5", "temperature": 0.3 }
    },
    {
      "id": "memory",
      "type": "memory",
      "label": "Conversation Memory",
      "position": { "x": 330, "y": 330 },
      "config": { "persistent": true, "session_key": "default" }
    },
    {
      "id": "calculator",
      "type": "tool",
      "label": "Calculator",
      "position": { "x": 540, "y": 330 },
      "config": { "tool_name": "calculator" }
    },
    {
      "id": "mcp_add",
      "type": "mcp",
      "label": "MCP: add",
      "position": { "x": 730, "y": 330 },
      "config": { "server": "demo-tools", "tool": "add" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start", "target": "assistant", "condition": null, "parallel": false },
    { "id": "e2", "source": "assistant", "target": "end", "condition": null, "parallel": false },
    { "id": "a1", "source": "chat_model", "target": "assistant", "attach": "model" },
    { "id": "a2", "source": "memory", "target": "assistant", "attach": "memory" },
    { "id": "a3", "source": "calculator", "target": "assistant", "attach": "tools" },
    { "id": "a4", "source": "mcp_add", "target": "assistant", "attach": "tools" }
  ],
  "automation": {
    "webhook_enabled": false,
    "schedule_enabled": false,
    "interval_seconds": 300
  }
}
